{
  "name": "myc",
  "version": "0.1.0",
  "private": true,
  "description": "MYC — Make Yourself Consistent",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev:web": "npm run dev -w @myc/web",
    "dev:mobile": "npm run start -w @myc/mobile",
    "android": "npm run android -w @myc/mobile",
    "build:web": "npm run build -w @myc/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "test": "npm run test --workspaces --if-present",
    "db:migration:new": "supabase migration new",
    "db:migrations": "supabase migration list --linked",
    "db:push:dry": "supabase db push --linked --dry-run",
    "db:push": "supabase db push --linked",
    "db:test": "supabase test db --linked",
    "db:types": "sh scripts/db-types.sh --linked",
    "db:types:check": "sh scripts/db-types.sh --linked --check",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types:local": "sh scripts/db-types.sh --local"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3"
  }
}
