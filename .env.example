# MYC environment variables — reference for the whole monorepo.
#
# Development: each app loads a git-ignored .env.local from its own directory.
#   cp apps/web/.env.example    apps/web/.env.local
#   cp apps/mobile/.env.example apps/mobile/.env.local
# Fill both with the DEVELOPMENT Supabase project
# (Dashboard → Project Settings → API Keys).
#
# Production: never use env files. Set the same variable names, pointing at the
# PRODUCTION Supabase project, in the deployment platform (e.g. Vercel project
# settings for web, EAS environment variables for mobile builds).
#
# Only the public URL and anon / publishable key (sb_publishable_…) belong in
# client apps; Row Level Security enforces access. NEVER put the service-role /
# secret key (sb_secret_…) in any NEXT_PUBLIC_* or EXPO_PUBLIC_* variable or in
# any client app: it bypasses RLS. ESLint rejects code that reads it.

# --- Web (apps/web/.env.local) ---------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Mobile (apps/mobile/.env.local) ---------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
