{
  "$schema": "https://json.schemastore.org/prettierrc",
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 100,
  "overrides": [
    {
      "files": "apps/web/**/*.{ts,tsx,css}",
      "options": {
        "plugins": ["prettier-plugin-tailwindcss"],
        "tailwindStylesheet": "./apps/web/src/app/globals.css",
        "tailwindFunctions": ["cn", "cva"]
      }
    }
  ]
}
