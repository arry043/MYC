# Copy to .env.local and fill in with the DEVELOPMENT Supabase project.
# See the root .env.example for details. Production builds get these from EAS
# environment variables, not from env files.
# EXPO_PUBLIC_* values are bundled into the app — never put secrets here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
