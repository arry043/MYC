<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_standard_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:padding="12dp">

    <!-- Signed In State -->
    <LinearLayout
        android:id="@+id/standard_container_signed_in"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/standard_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MYC"
                    android:textColor="@color/myc_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/standard_header_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today\'s Commitments"
                    android:textColor="@color/myc_text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/standard_progress_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pill_primary"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="0/0"
                android:textColor="@color/myc_primary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/standard_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_pill_flame"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="🔥 0 days"
                android:textColor="@color/myc_flame"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Divider line -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/myc_border"
            android:layout_marginBottom="6dp" />

        <!-- Empty State Container -->
        <LinearLayout
            android:id="@+id/standard_empty_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All clear for today ✨"
                android:textColor="@color/myc_text_main"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="No commitments scheduled"
                android:textColor="@color/myc_text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Commitments List Container -->
        <LinearLayout
            android:id="@+id/standard_commitments_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Item 1 -->
            <LinearLayout
                android:id="@+id/standard_row_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/standard_check_1"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/widget_ic_circle" />

                <TextView
                    android:id="@+id/standard_title_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/myc_text_main"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Item 2 -->
            <LinearLayout
                android:id="@+id/standard_row_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/standard_check_2"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/widget_ic_circle" />

                <TextView
                    android:id="@+id/standard_title_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/myc_text_main"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Item 3 -->
            <LinearLayout
                android:id="@+id/standard_row_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/standard_check_3"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/widget_ic_circle" />

                <TextView
                    android:id="@+id/standard_title_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/myc_text_main"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Item 4 -->
            <LinearLayout
                android:id="@+id/standard_row_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/standard_check_4"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/widget_ic_circle" />

                <TextView
                    android:id="@+id/standard_title_4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/myc_text_main"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Overflow row -->
            <TextView
                android:id="@+id/standard_overflow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="2dp"
                android:textColor="@color/myc_text_muted"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Signed Out State -->
    <LinearLayout
        android:id="@+id/standard_container_signed_out"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_primary"
            android:paddingStart="10dp"
            android:paddingTop="2dp"
            android:paddingEnd="10dp"
            android:paddingBottom="2dp"
            android:text="MYC"
            android:textColor="@color/myc_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Sign in to view commitments"
            android:textColor="@color/myc_text_main"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="Stay consistent with your daily goals"
            android:textColor="@color/myc_text_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/standard_btn_sign_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/widget_button_primary"
            android:paddingStart="14dp"
            android:paddingTop="5dp"
            android:paddingEnd="14dp"
            android:paddingBottom="5dp"
            android:text="Sign In"
            android:textColor="@color/myc_white"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>

