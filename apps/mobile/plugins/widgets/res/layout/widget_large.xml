<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_large_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:padding="14dp">

    <!-- Signed In State -->
    <LinearLayout
        android:id="@+id/large_container_signed_in"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Top Header -->
        <LinearLayout
            android:id="@+id/large_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MYC"
                    android:textColor="@color/myc_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Consistency Dashboard"
                    android:textColor="@color/myc_text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/large_current_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pill_flame"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="🔥 0 days"
                android:textColor="@color/myc_flame"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/large_best_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_pill_trophy"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="🏆 0d best"
                android:textColor="#CA8A04"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Progress Overview -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today\'s Progress"
                    android:textColor="@color/myc_text_main"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/large_progress_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 of 0 completed (0%)"
                    android:textColor="@color/myc_primary"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/large_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress_drawable" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/myc_border"
            android:layout_marginBottom="4dp" />

        <!-- Commitments Section Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TODAY\'S COMMITMENTS"
            android:textColor="@color/myc_text_subtle"
            android:textSize="9sp"
            android:textStyle="bold"
            android:layout_marginBottom="3dp" />

        <!-- Empty State Container -->
        <LinearLayout
            android:id="@+id/large_empty_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All clear for today ✨"
                android:textColor="@color/myc_text_main"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="No commitments scheduled for today"
                android:textColor="@color/myc_text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Commitments List Container -->
        <LinearLayout
            android:id="@+id/large_commitments_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Item 1 -->
            <LinearLayout
                android:id="@+id/large_row_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/large_check_1"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/widget_ic_circle" />

                <TextView
                    android:id="@+id/large_title_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/myc_text_main"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Item 2 -->
            <LinearLayout
                android:id="@+id/large_row_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/large_check_2"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/widget_ic_circle" />

                <TextView
                    android:id="@+id/large_title_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/myc_text_main"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Item 3 -->
            <LinearLayout
                android:id="@+id/large_row_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/large_check_3"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/widget_ic_circle" />

                <TextView
                    android:id="@+id/large_title_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/myc_text_main"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Item 4 -->
            <LinearLayout
                android:id="@+id/large_row_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/large_check_4"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/widget_ic_circle" />

                <TextView
                    android:id="@+id/large_title_4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/myc_text_main"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Item 5 -->
            <LinearLayout
                android:id="@+id/large_row_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/large_check_5"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/widget_ic_circle" />

                <TextView
                    android:id="@+id/large_title_5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/myc_text_main"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Overflow row -->
            <TextView
                android:id="@+id/large_overflow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="2dp"
                android:textColor="@color/myc_text_muted"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Footer Action Button -->
        <TextView
            android:id="@+id/large_btn_open"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_button_primary"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="Open MYC"
            android:textColor="@color/myc_white"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Signed Out State -->
    <LinearLayout
        android:id="@+id/large_container_signed_out"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_primary"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:text="MYC"
            android:textColor="@color/myc_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Consistency Dashboard"
            android:textColor="@color/myc_text_main"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Sign in to view your scheduled commitments, track your streaks, and build daily consistency."
            android:textColor="@color/myc_text_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/large_btn_sign_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/widget_button_primary"
            android:paddingStart="18dp"
            android:paddingTop="7dp"
            android:paddingEnd="18dp"
            android:paddingBottom="7dp"
            android:text="Sign In to MYC"
            android:textColor="@color/myc_white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>

