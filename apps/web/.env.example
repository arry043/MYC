# Copy to .env.local and fill in with the DEVELOPMENT Supabase project.
# See the root .env.example for details. Production values are set in the
# deployment platform, not in env files.
# NEXT_PUBLIC_* values are shipped to the browser — never put secrets here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
